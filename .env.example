# 服务端口，固定只绑 127.0.0.1
ANSWERER_PORT=8787

# 故障转移链：逗号分隔的 provider id，按顺序尝试；留空则退回 ANSWERER_PROVIDER
# 例：ANSWERER_CHAIN=openai,deepseek,ollama
ANSWERER_CHAIN=

# 单 provider 兼容写法（ANSWERER_CHAIN 未设置时生效）；mock：预置答案，不联网
ANSWERER_PROVIDER=openai

# 供应商预设表与本地覆盖（config/providers.local.json 已 gitignore）
ANSWERER_PROVIDERS_FILE=config/providers.json

# 各家的 key 走各自的环境变量名（见 README 的 provider 表）；常见几个：
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENCODE_GO_API_KEY=   # OpenCode 目录型 provider（opencode / opencode-go）共用；只需填模型 id，baseUrl 运行时从目录解析

# 旧的单 provider 覆盖：设置后只覆盖链上第一家（baseUrl 填到 /v1 这一层）
ANSWERER_BASE_URL=
ANSWERER_API_KEY=

# 单 provider 的全局模型名；混合链（ANSWERER_CHAIN 多家）必须在
# config/providers.local.json 里逐家指定 model，否则拒绝启动
ANSWERER_MODEL=

# 自洽采样次数（1-10）：同一题打乱选项顺序问 K 次，取多数票
ANSWERER_K=3

# 置信度阈值：仅当 provider 返回 logprobs 时生效
ANSWERER_MARGIN=0.15

# 单次模型请求超时（毫秒）
ANSWERER_TIMEOUT_MS=20000

# 埋点开关与是否需要 logprobs（多数网关不支持，默认关）
ANSWERER_LOG=1
ANSWERER_LOGPROBS=0

# mock provider 的预置答案（仅 ANSWERER_PROVIDER=mock 时使用）
# ANSWERER_MOCK_LETTERS=3
# ANSWERER_MOCK_ANSWERS=答案一;答案二
# ANSWERER_MOCK_MARGIN=0.5

# 订阅 OAuth（实验性，默认关闭；详见 README「订阅 OAuth」）
# 留空则读取 claude / codex 自己的凭据文件，不要提交填好的 .env
# ANTHROPIC_OAUTH_TOKEN=
# OPENAI_OAUTH_TOKEN=
# OPENAI_ACCOUNT_ID=
